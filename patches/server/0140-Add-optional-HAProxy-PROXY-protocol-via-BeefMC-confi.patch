                         .addLast("prepender", PacketPrepender.INSTANCE) // PandaSpigot - Share PacketPrepender instance
                         .addLast("encoder", new PacketEncoder(EnumProtocolDirection.CLIENTBOUND));
                     // PandaSpigot end
+                    // BeefMC start - HAProxy PROXY protocol support
+                    if (com.hpfxd.pandaspigot.config.PandaSpigotConfig.get().proxies.proxyProtocol) {
+                        channel.pipeline().addAfter("timeout", "haproxy-decoder", new io.netty.handler.codec.haproxy.HAProxyMessageDecoder());
