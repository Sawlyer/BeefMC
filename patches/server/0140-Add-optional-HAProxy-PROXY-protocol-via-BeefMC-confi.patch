@@ -107,6 +126,15 @@ public class PandaSpigotConfig {
         "match your proxy's online-mode setting.")
     public boolean proxyOnlineMode = true;
 
+    public Proxies proxies = new Proxies();
+
+    @ConfigSerializable
+    public static class Proxies {
+        @Setting("proxy-protocol")
+        @Comment("Accept HAProxy PROXY protocol headers before the Minecraft handshake. Enable only when every connection reaches this server through a trusted proxy; the server port must be firewalled.")
