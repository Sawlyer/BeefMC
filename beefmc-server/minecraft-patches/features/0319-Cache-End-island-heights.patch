From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maxime Chaffraix <160416029+Sawlyer@users.noreply.github.com>
Date: Sun, 15 Nov 2026 11:04:56 +0100
Subject: [PATCH] Cache End island heights


diff --git a/net/minecraft/world/level/levelgen/DensityFunctions.java b/net/minecraft/world/level/levelgen/DensityFunctions.java
index bfcbd14ed56bb26a0bfa9de7f1b27f5357e51b2b..dbd8f4111400219996be53e37bf8dc871da19ccf 100644
--- a/net/minecraft/world/level/levelgen/DensityFunctions.java
+++ b/net/minecraft/world/level/levelgen/DensityFunctions.java
@@ -536,8 +536,13 @@ public final class DensityFunctions {
         private static final class NoiseCache {
             public long[] keys = new long[8192];
             public float[] values = new float[8192];
+            private static final int HEIGHT_CACHE_SIZE = 512;
+            private final long[] heightKeys = new long[HEIGHT_CACHE_SIZE];
+            private final float[] heights = new float[HEIGHT_CACHE_SIZE];
+            private boolean fixFarEnd;
             public NoiseCache() {
                 java.util.Arrays.fill(keys, Long.MIN_VALUE);
+                java.util.Arrays.fill(this.heightKeys, Long.MIN_VALUE);
             }
         }
         private static final ThreadLocal<java.util.Map<SimplexNoise, NoiseCache>> noiseCache = ThreadLocal.withInitial(java.util.WeakHashMap::new);
@@ -550,14 +555,25 @@ public final class DensityFunctions {
         }
 
         private static float getHeightValue(final SimplexNoise islandNoise, final int sectionX, final int sectionZ) {
+            NoiseCache cache = noiseCache.get().computeIfAbsent(islandNoise, noiseKey -> new NoiseCache());
+            boolean fixFarEnd = ca.spottedleaf.moonrise.common.PlatformHooks.get().configFixMC159283();
+            if (cache.fixFarEnd != fixFarEnd) {
+                java.util.Arrays.fill(cache.heightKeys, Long.MIN_VALUE);
+                cache.fixFarEnd = fixFarEnd;
+            }
+            long heightKey = net.minecraft.world.level.ChunkPos.pack(sectionX, sectionZ);
+            int heightIndex = (int) it.unimi.dsi.fastutil.HashCommon.mix(heightKey) & (NoiseCache.HEIGHT_CACHE_SIZE - 1);
+            if (cache.heightKeys[heightIndex] == heightKey) {
+                return cache.heights[heightIndex];
+            }
+
             int chunkX = sectionX / 2;
             int chunkZ = sectionZ / 2;
             int subSectionX = sectionX % 2;
             int subSectionZ = sectionZ % 2;
-            float doffs = 100.0F - (ca.spottedleaf.moonrise.common.PlatformHooks.get().configFixMC159283() ? Mth.sqrt((long) sectionX * (long) sectionX + (long) sectionZ * (long) sectionZ) : Mth.sqrt(sectionX * sectionX + sectionZ * sectionZ)) * 8.0F; // Paper - cast ints to long when MC-159283 fix enabled
+            float doffs = 100.0F - (fixFarEnd ? Mth.sqrt((long) sectionX * (long) sectionX + (long) sectionZ * (long) sectionZ) : Mth.sqrt(sectionX * sectionX + sectionZ * sectionZ)) * 8.0F; // Paper - cast ints to long when MC-159283 fix enabled
             doffs = Mth.clamp(doffs, -100.0F, 80.0F);
 
-            NoiseCache cache = noiseCache.get().computeIfAbsent(islandNoise, noiseKey -> new NoiseCache()); // Paper - Perf: Optimize end generation
             for (int xo = -12; xo <= 12; xo++) {
                 for (int zo = -12; zo <= 12; zo++) {
                     long totalChunkX = chunkX + xo;
@@ -588,6 +604,8 @@ public final class DensityFunctions {
                 }
             }
 
+            cache.heightKeys[heightIndex] = heightKey;
+            cache.heights[heightIndex] = doffs;
             return doffs;
         }
 
